    "content": "[package]\nname = \u0022coding-assistant\u0022\nversion = \u00220.1.0\u0022\ndescription = \u0022A Freya-based coding assistant GUI that turns natural-language chat into runnable code in an editor and terminal.\u0022\nlicense = \u0022MIT\u0022\npublish = false\nedition = \u00222024\u0022\n\n# Optimized release builds for distribution.\n[profile.release]\n# Full link-time optimization across the whole program.\nlto = true\n# Single codegen unit maximizes optimization opportunities.\ncodegen-units = 1\n# Strip debug symbols from the binary to reduce size.\nstrip = true\n# Optimize for speed.\nopt-level = 3\n# Panics abort instead of unwinding, producing a smaller binary.\npanic = \u0022abort\u0022\n\n[workspace]\n# Single-crate workspace root. This makes the project a proper Cargo workspace\n# and enables reproducible builds via the committed Cargo.lock.\nmembers = [\u0022.\u0022]\nresolver = \u00222\u0022\n\n# macOS .app bundle configuration (used by \u0060cargo bundle\u0060).\n[package.metadata.bundle]\nname = \u0022Coding Assistant\u0022\nidentifier = \u0022com.example.coding-assistant\u0022\nicon = [\u0022assets/icon.icns\u0022]\ncategory = \u0022public.app-category.developer-tools\u0022\nshort_description = \u0022A coding assistant that turns chat into runnable code.\u0022\n\n# Linux .deb package configuration (used by \u0060cargo deb\u0060).\n[package.metadata.deb]\nmaintainer = \u0022Coding Assistant Developers \u003Cdev@example.com\u003E\u0022\ncopyright = \u00222026 Coding Assistant Developers\u0022\nlicense-file = [\u0022LICENSE\u0022]\nsection = \u0022utility\u0022\npriority = \u0022optional\u0022\nassets = [\n  [\u0022target/release/coding-assistant\u0022, \u0022usr/bin/\u0022, \u0022755\u0022],\n]\n\n[dependencies]\nfreya = { version = \u00220.5.0-rc.3\u0022, features = [\u0022markdown\u0022, \u0022terminal\u0022, \u0022remote-asset\u0022, \u0022code-editor\u0022] }\nrig-core = \u00220.32.0\u0022\ntokio = { version = \u00221.0\u0022, features = [\u0022rt\u0022, \u0022rt-multi-thread\u0022, \u0022time\u0022, \u0022macros\u0022] }\nfutures-util = \u00220.3.31\u0022\nopen = \u00225.4.1\u0022\nbytes = \u00221.10.1\u0022\nfreya-engine = \u00220.5.0-rc.3\u0022\nropey = \u00221.6.1\u0022\ntree-sitter-rust = \u00220.24\u0022\ntree-sitter-python = \u00220.25.0\u0022\ntree-sitter-c = \u00220.24.2\u0022\ntree-sitter-cpp = \u00220.23.4\u0022\ntree-sitter-java = \u00220.23.5\u0022\ntree-sitter-go = \u00220.25.0\u0022\ntree-sitter-typescript = \u00220.23.2\u0022\ntree-sitter-javascript = \u00220.25.0\u0022\ntree-sitter-html = \u00220.23.2\u0022\ntree-sitter-css = \u00220.25.0\u0022\nrio-vt = \u00220.5\u0022\nserde = { version = \u00221\u0022, features = [\u0022derive\u0022] }\nserde_json = \u00221\u0022\ntoml = \u00220.8\u0022\nthiserror = \u00222.0.17\u0022\n"
